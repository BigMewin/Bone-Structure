bone_threshold = 3000;

% Process each slice individually
for sliceIdx = 1:num_slices
    % Extract the current slice
    current_slice = img(:,:,sliceIdx);

    % Segment potential bone regions based on the threshold
    bone_mask = current_slice > bone_threshold;

    % Perform morphological closing to close gaps in the bone region
    % Adjust the size of the structuring element as necessary
    se = strel('disk', 10);
    closed_bone_mask = imclose(bone_mask, se);
    
    % Fill in holes within the regions to solidify the bone
    solid_bone_mask = imfill(closed_bone_mask, 'holes');

    % Keep only the largest connected component (assuming it's the bone)
    CC = bwconncomp(solid_bone_mask);
    numPixels = cellfun(@numel, CC.PixelIdxList);
    [biggest, idx] = max(numPixels);
    if ~isempty(idx)
        bone_only_mask = false(size(solid_bone_mask));
        bone_only_mask(CC.PixelIdxList{idx}) = true;
        segmented_img_stack(:,:,sliceIdx) = bone_only_mask;
    end
end

