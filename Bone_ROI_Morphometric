    yRange = max(round(y - edge_length_voxels / 2 - additional_voxels), 1):min(round(y + edge_length_voxels / 2 + additional_voxels), dimY);
    xRange = max(round(x - edge_length_voxels / 2 - additional_voxels), 1):min(round(x + edge_length_voxels / 2 + additional_voxels), dimX);
    zRange = max(round(z - edge_length_voxels / 2 - additional_voxels), 1):min(round(z + edge_length_voxels / 2 + additional_voxels), dimZ);
    
    % Extract the ROI content
    roi_content = movingVolume(yRange, xRange, zRange);  % Changed to Y, X, Z order
    
    % Initialize binary ROI content
    binary_roi_content = false(size(roi_content));
    
    % Create a binary mask for the square ROI
    mask = true(size(roi_content));
    
    % Apply the mask to the ROI content
    masked_roi_content = roi_content;
    masked_roi_content(~mask) = 0;
    
    % Adjust contrast and apply Otsu's threshold for each slice
    for sliceIdx = 1:size(masked_roi_content, 3)
        slice = masked_roi_content(:, :, sliceIdx);
        adjusted_slice = imadjust(slice);
        threshold = graythresh(adjusted_slice) * max(adjusted_slice(:));
        binary_roi_content(:, :, sliceIdx) = imbinarize(adjusted_slice, threshold);
    end
    
    % Ensure no slice is completely filled with 255 values
    for sliceIdx = 1:size(binary_roi_content, 3)
        if all(binary_roi_content(:, :, sliceIdx), 'all')
            binary_roi_content(:, :, sliceIdx) = false;
        end
    end
    
    % Store the binary ROI content
    rois{i} = binary_roi_content;
    
    % Add the mask to the image for visualization
    showImg(yRange, xRange, zRange) = showImg(yRange, xRange, zRange) + double(binary_roi_content) * 100000;  % Changed to Y, X, Z order
end

